SENTINEL_ENVIRONMENT=test
SENTINEL_DATABASE_URL=postgresql://sentinelward@127.0.0.1:5432/sentinelward
SENTINEL_MQTT_HOST=127.0.0.1
SENTINEL_MQTT_PORT=8883
SENTINEL_MQTT_CLIENT_ID=sentinelward-automation
SENTINEL_MQTT_USERNAME=replace-me
SENTINEL_MQTT_PASSWORD=replace-me
SENTINEL_MQTT_CA_FILE=/etc/sentinelward/ca.crt
SENTINEL_MQTT_TLS=true
SENTINEL_BACKEND_BASE_URL=https://backend.example.invalid
SENTINEL_BACKEND_SERVICE_TOKEN=replace-me
SENTINEL_EXTERNAL_EFFECT_MODE=simulate
# M6 is disabled until episode/device context is supplied. Research in test/demo only.
SENTINEL_M6_ENABLED=false
SENTINEL_M6_CONTEXTS_FILE=/etc/sentinelward/m6-contexts.json
# Optional frozen validation artifact; omit to use explicit uncalibrated research settings.
# SENTINEL_M6_CALIBRATION_FILE=/etc/sentinelward/m6-calibration.json
SENTINEL_TELEGRAM_BOT_TOKEN=replace-me
SENTINEL_TELEGRAM_RECIPIENTS_FILE=/etc/sentinelward/telegram-recipients.json
SENTINEL_ALERT_DEMO_SECONDS=30
SENTINEL_ALERT_DESIGN_REAL_SECONDS=60
SENTINEL_HTTP_HOST=127.0.0.1
SENTINEL_HTTP_PORT=8088
SENTINEL_LOG_LEVEL=INFO
LANGGRAPH_STRICT_MSGPACK=true
